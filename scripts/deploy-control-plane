#!/usr/bin/env bash
# Deploy the hosted Dirt control plane through the supported Railway flow.
#
# The script intentionally applies cloud Atlas migrations before uploading app
# code. It never prints .env.prod values; keep xtrace disabled when running it.

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
ENV_FILE="${DIRT_CONTROL_PLANE_ENV_FILE:-$ROOT_DIR/.env.prod}"
BASE_ENV_FILE="${DIRT_CONTROL_PLANE_BASE_ENV_FILE:-$ROOT_DIR/.env}"

usage() {
    cat <<'EOF'
Usage: scripts/deploy-control-plane [--skip-smoke] [--verify-context-only]

Loads .env first and .env.prod second by default, applies cloud Atlas
migrations, deploys apps/control-plane to Railway service control-plane-api,
deploys web-ui to Railway service web-ui, then runs public smoke checks.

--verify-context-only builds and imports the isolated API upload context without
requiring deployment credentials or changing hosted state.

Set DIRT_CONTROL_PLANE_ENV_FILE=/path/to/env to use a different ignored env file.
Set DIRT_CONTROL_PLANE_BASE_ENV_FILE=/path/to/env to override the base .env.
Set DIRT_RAILWAY_VARIABLE_SYNC_TIMEOUT_S=seconds to override the bulk variable
sync HTTP timeout.
Set DIRT_RAILWAY_VARIABLE_SYNC_ATTEMPTS=count to override bulk variable sync retries.
EOF
}

SKIP_SMOKE=0
VERIFY_CONTEXT_ONLY=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --skip-smoke)
            SKIP_SMOKE=1
            shift
            ;;
        --verify-context-only)
            VERIFY_CONTEXT_ONLY=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "ERROR: unknown argument: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

if [ -f "$BASE_ENV_FILE" ]; then
    set -a
    # shellcheck disable=SC1090
    source "$BASE_ENV_FILE"
    set +a
fi

if [ -f "$ENV_FILE" ]; then
    set -a
    # shellcheck disable=SC1090
    source "$ENV_FILE"
    set +a
fi

require_cmd() {
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "ERROR: required command not found: $1" >&2
        exit 1
    fi
}

require_env() {
    local name="$1"
    if [ -z "${!name:-}" ]; then
        echo "ERROR: required environment variable is unset: $name" >&2
        exit 1
    fi
}

latest_deployment_field() {
    local service_id="$1"
    local field="$2"

    railway deployment list \
        --service "$service_id" \
        --environment "$RAILWAY_ENVIRONMENT" \
        --json \
        | uv run python -c 'import json, sys
data = json.load(sys.stdin)
field = sys.argv[1]
print(data[0].get(field, "") if data else "")' "$field"
}

wait_for_latest_deployment_success() {
    local label="$1"
    local service_id="$2"
    local deployment_id="$3"
    local attempts="${DIRT_CONTROL_PLANE_DEPLOY_ATTEMPTS:-120}"
    local delay="${DIRT_CONTROL_PLANE_DEPLOY_DELAY_S:-5}"
    local status=""

    echo "Waiting for $label deployment $deployment_id..."
    for attempt in $(seq 1 "$attempts"); do
        status="$(
            railway deployment list \
                --service "$service_id" \
                --environment "$RAILWAY_ENVIRONMENT" \
                --json \
                | uv run python -c 'import json, sys
data = json.load(sys.stdin)
deployment_id = sys.argv[1]
for deployment in data:
    if deployment.get("id") == deployment_id:
        print(deployment.get("status", ""))
        break' "$deployment_id"
        )"
        case "$status" in
            SUCCESS)
                echo "$label deployment succeeded."
                return 0
                ;;
            FAILED|CRASHED|REMOVED|SKIPPED)
                echo "ERROR: $label deployment ended with status $status" >&2
                return 1
                ;;
        esac
        if [ "$attempt" -eq "$attempts" ]; then
            break
        fi
        sleep "$delay"
    done

    echo "ERROR: $label deployment did not reach SUCCESS (last status: ${status:-unknown})" >&2
    return 1
}

CONTROL_PLANE_DEPLOY_DIR=""
cleanup() {
    if [ -n "$CONTROL_PLANE_DEPLOY_DIR" ] && [ -d "$CONTROL_PLANE_DEPLOY_DIR" ]; then
        rm -rf "$CONTROL_PLANE_DEPLOY_DIR"
    fi
}
trap cleanup EXIT

prepare_control_plane_deploy_context() {
    CONTROL_PLANE_DEPLOY_DIR="$(mktemp -d)"
    cp -R "$ROOT_DIR/apps/control-plane/." "$CONTROL_PLANE_DEPLOY_DIR/"
    find "$CONTROL_PLANE_DEPLOY_DIR" -name __pycache__ -type d -prune -exec rm -rf {} +

    # Railway deploys apps/control-plane as an isolated package, but the
    # gateway API shares its wire DTOs and history policy with the local gateway
    # via dirt_shared. Stage those focused modules into the upload context so
    # production imports match the repository source of truth without uploading
    # the whole workspace.
    mkdir -p "$CONTROL_PLANE_DEPLOY_DIR/src/dirt_shared"
    for module in cloud_contract.py metric_history.py; do
        cp "$ROOT_DIR/apps/shared/src/dirt_shared/$module" \
            "$CONTROL_PLANE_DEPLOY_DIR/src/dirt_shared/$module"
    done
    printf '"""Deploy-time subset of dirt_shared used by dirt-control-plane."""\n' \
        >"$CONTROL_PLANE_DEPLOY_DIR/src/dirt_shared/__init__.py"
}

verify_control_plane_deploy_context() {
    echo "Verifying isolated control-plane deploy context..."
    PYTHONDONTWRITEBYTECODE=1 \
        PYTHONPATH="$CONTROL_PLANE_DEPLOY_DIR/src" \
        uv run --isolated --project "$CONTROL_PLANE_DEPLOY_DIR" --no-dev \
        python -c 'from dirt_control.app import create_app'
}

wait_for_http() {
    local label="$1"
    local url="$2"
    local attempts="${DIRT_CONTROL_PLANE_SMOKE_ATTEMPTS:-180}"
    local delay="${DIRT_CONTROL_PLANE_SMOKE_DELAY_S:-5}"

    echo "Checking $label..."
    for attempt in $(seq 1 "$attempts"); do
        if curl -fsS "$url" >/dev/null 2>&1; then
            echo "$label is reachable."
            return 0
        fi
        if [ "$attempt" -eq "$attempts" ]; then
            break
        fi
        sleep "$delay"
    done

    echo "ERROR: $label did not become reachable at $url" >&2
    return 1
}

sync_railway_variables_from_env() {
    local service_id="$1"
    shift

    if [ "$#" -eq 0 ]; then
        return 0
    fi

    uv run python - "$service_id" "$@" <<'PY'
import json
import os
import subprocess
import sys
import time
import tempfile

service_id = sys.argv[1]
names = sys.argv[2:]
variables = {name: os.environ[name] for name in names if os.environ.get(name)}

if not variables:
    raise SystemExit(0)

required = [
    "RAILWAY_API_TOKEN",
    "RAILWAY_PROJECT_ID",
    "RAILWAY_ENVIRONMENT_ID",
]
missing = [name for name in required if not os.environ.get(name)]
if missing:
    print(
        "ERROR: required environment variable is unset: " + ", ".join(missing),
        file=sys.stderr,
    )
    raise SystemExit(1)

body = json.dumps(
    {
        "query": """
mutation VariableCollectionUpsert($input: VariableCollectionUpsertInput!) {
  variableCollectionUpsert(input: $input)
}
""",
        "variables": {
            "input": {
                "projectId": os.environ["RAILWAY_PROJECT_ID"],
                "environmentId": os.environ["RAILWAY_ENVIRONMENT_ID"],
                "serviceId": service_id,
                "variables": variables,
                "replace": False,
                "skipDeploys": True,
            }
        },
    }
)

attempts = int(os.environ.get("DIRT_RAILWAY_VARIABLE_SYNC_ATTEMPTS", "3"))
timeout_s = float(os.environ.get("DIRT_RAILWAY_VARIABLE_SYNC_TIMEOUT_S", "60"))
curl_config_path = ""

try:
    with tempfile.NamedTemporaryFile("w", delete=False) as curl_config:
        curl_config_path = curl_config.name
        os.chmod(curl_config_path, 0o600)
        curl_config.write(
            f'header = "Authorization: Bearer {os.environ["RAILWAY_API_TOKEN"]}"\n'
        )
        curl_config.write('header = "Content-Type: application/json"\n')

    for attempt in range(1, attempts + 1):
        proc = subprocess.run(
            [
                "curl",
                "-sS",
                "--connect-timeout",
                "15",
                "--max-time",
                str(timeout_s),
                "--config",
                curl_config_path,
                "--data-binary",
                "@-",
                "https://backboard.railway.com/graphql/v2",
            ],
            input=body,
            capture_output=True,
            text=True,
            check=False,
        )

        if proc.returncode != 0:
            if attempt == attempts:
                print(
                    f"ERROR: Railway bulk variable sync failed for service {service_id} "
                    f"after {attempts} attempts: {proc.stderr.strip()}",
                    file=sys.stderr,
                )
                raise SystemExit(1)
            print(
                f"Retrying Railway bulk variable sync for service {service_id} "
                f"after failed attempt {attempt}/{attempts}...",
                file=sys.stderr,
            )
            time.sleep(3)
            continue

        try:
            payload = json.loads(proc.stdout)
        except json.JSONDecodeError as exc:
            if attempt == attempts:
                print(
                    f"ERROR: Railway bulk variable sync returned invalid JSON "
                    f"for service {service_id}: {exc}",
                    file=sys.stderr,
                )
                raise SystemExit(1) from exc
            print(
                f"Retrying Railway bulk variable sync for service {service_id} "
                f"after invalid JSON on attempt {attempt}/{attempts}...",
                file=sys.stderr,
            )
            time.sleep(3)
            continue

        errors = payload.get("errors")
        if errors:
            messages = "; ".join(str(error.get("message", error)) for error in errors)
            print(
                f"ERROR: Railway bulk variable sync failed for service {service_id}: "
                f"{messages}",
                file=sys.stderr,
            )
            raise SystemExit(1)

        if payload.get("data", {}).get("variableCollectionUpsert") is not True:
            print(
                f"ERROR: Railway bulk variable sync returned an unexpected response "
                f"for service {service_id}",
                file=sys.stderr,
            )
            raise SystemExit(1)

        print(f"Synced {len(variables)} Railway variables for service {service_id}.")
        raise SystemExit(0)
finally:
    if curl_config_path:
        try:
            os.unlink(curl_config_path)
        except OSError:
            pass
PY
}

require_envs() {
    local name
    for name in "$@"; do
        require_env "$name"
    done
}

if [ "$VERIFY_CONTEXT_ONLY" -eq 1 ]; then
    require_cmd uv
    cd "$ROOT_DIR"
    prepare_control_plane_deploy_context
    verify_control_plane_deploy_context
    echo "Control-plane deploy context is valid."
    exit 0
fi

require_cmd atlas
require_cmd railway
require_cmd curl
require_cmd uv

require_env RAILWAY_API_TOKEN
require_env RAILWAY_PROJECT_ID
require_env RAILWAY_ENVIRONMENT
require_env RAILWAY_ENVIRONMENT_ID
require_env RAILWAY_CONTROL_PLANE_API_SERVICE_ID
require_env RAILWAY_WEB_UI_SERVICE_ID
require_env RAILWAY_POSTGRES_SERVICE_ID
require_env DIRT_CLOUD_API_BASE_URL
require_env DIRT_CLOUD_UI_BASE_URL

if [ -z "${DIRT_CLOUD_DATABASE_URL:-}" ]; then
    DIRT_CLOUD_DATABASE_URL="$(
        railway variable list \
            --service "$RAILWAY_POSTGRES_SERVICE_ID" \
            --environment "$RAILWAY_ENVIRONMENT" \
            --json \
            | uv run python -c 'import json, sys; data = json.load(sys.stdin); print(data.get("DATABASE_PUBLIC_URL") or "")'
    )"
    export DIRT_CLOUD_DATABASE_URL
fi
require_env DIRT_CLOUD_DATABASE_URL

cd "$ROOT_DIR"

prepare_control_plane_deploy_context
verify_control_plane_deploy_context

echo "Syncing Railway service variables..."
require_envs \
    DIRT_CLOUD_ADMIN_USERNAME \
    DIRT_CLOUD_ADMIN_PASSWORD_HASH \
    DIRT_CLOUD_SESSION_SECRET \
    DIRT_CLOUD_GATEWAY_TOKEN_SHA256 \
    DIRT_CLOUD_ALLOWED_ORIGINS \
    DIRT_CLOUD_UI_BASE_URL
sync_railway_variables_from_env \
    "$RAILWAY_CONTROL_PLANE_API_SERVICE_ID" \
    DIRT_CLOUD_ADMIN_USERNAME \
    DIRT_CLOUD_ADMIN_PASSWORD_HASH \
    DIRT_CLOUD_SESSION_SECRET \
    DIRT_CLOUD_GATEWAY_TOKEN_SHA256 \
    DIRT_CLOUD_ALLOWED_ORIGINS \
    DIRT_CLOUD_UI_BASE_URL \
    DIRT_CLOUD_ASSET_RETENTION_DAYS \
    DIRT_CLOUD_ASSET_STORE \
    DIRT_CLOUD_ASSET_PUBLIC_BASE_URL \
    DIRT_CLOUD_BUCKET_NAME \
    DIRT_CLOUD_COMMAND_CREATION_ENABLED \
    DIRT_CLOUD_GATEWAY_COMMAND_CLAIM_ENABLED \
    DIRT_CLOUD_S3_ACCESS_KEY_ID \
    DIRT_CLOUD_S3_ENDPOINT \
    DIRT_CLOUD_S3_REGION \
    DIRT_CLOUD_S3_SECRET_ACCESS_KEY \
    DIRT_CLOUD_SITE_ID
require_env VITE_DIRT_API_BASE_URL
sync_railway_variables_from_env \
    "$RAILWAY_WEB_UI_SERVICE_ID" \
    VITE_DIRT_API_BASE_URL

echo "Applying cloud Atlas migrations..."
atlas migrate apply --env cloud

echo "Ensuring cloud gateway credential..."
uv run --package dirt-control-plane python -m dirt_control.bootstrap_gateway

echo "Deploying control-plane API to Railway service control-plane-api..."
railway up "$CONTROL_PLANE_DEPLOY_DIR" \
    --path-as-root \
    --project "$RAILWAY_PROJECT_ID" \
    --environment "$RAILWAY_ENVIRONMENT" \
    --service "$RAILWAY_CONTROL_PLANE_API_SERVICE_ID"
control_plane_deployment_id="$(latest_deployment_field "$RAILWAY_CONTROL_PLANE_API_SERVICE_ID" id)"
wait_for_latest_deployment_success \
    "control-plane API" \
    "$RAILWAY_CONTROL_PLANE_API_SERVICE_ID" \
    "$control_plane_deployment_id"

if [ "$SKIP_SMOKE" -eq 0 ]; then
    wait_for_http "cloud API health" "$DIRT_CLOUD_API_BASE_URL/api/health"
fi

echo "Deploying web UI to Railway service web-ui..."
railway up "$ROOT_DIR/web-ui" \
    --path-as-root \
    --project "$RAILWAY_PROJECT_ID" \
    --environment "$RAILWAY_ENVIRONMENT" \
    --service "$RAILWAY_WEB_UI_SERVICE_ID"
web_ui_deployment_id="$(latest_deployment_field "$RAILWAY_WEB_UI_SERVICE_ID" id)"
wait_for_latest_deployment_success \
    "web UI" \
    "$RAILWAY_WEB_UI_SERVICE_ID" \
    "$web_ui_deployment_id"

if [ "$SKIP_SMOKE" -eq 0 ]; then
    wait_for_http "hosted UI" "$DIRT_CLOUD_UI_BASE_URL/"
fi

echo "Control-plane deploy finished."
